# Development Dockerfile — hot reload + bind mount
FROM node:20-alpine

WORKDIR /app

# ติดตั้ง build tools สำหรับ native modules
RUN apk add --no-cache python3 make g++

# ติดตั้ง bun
RUN npm install -g bun

# ติดตั้ง tsx สำหรับรัน TypeScript โดยตรง
RUN npm install -g tsx

COPY package.json bun.lock* ./
RUN bun install

# Copy source code (ใช้สำหรับ migrate container / ถ้า bind mount จะทับ)
COPY . .

# Expose app + Vite HMR
EXPOSE 3100
EXPOSE 5173

ENV NODE_ENV=development
ENV APP_PORT=3100

CMD ["bun", "run", "dev"]
