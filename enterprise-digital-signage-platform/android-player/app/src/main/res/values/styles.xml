<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base theme -->
    <style name="Theme.SignagePlayer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#8083FF</item>
        <item name="colorPrimaryDark">#0B0E14</item>
        <item name="colorAccent">#4CD7F6</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColor">#E1E2EB</item>
        <item name="android:statusBarColor">#0B0E14</item>
        <item name="android:navigationBarColor">#0B0E14</item>
    </style>

    <!-- Fullscreen immersive theme for kiosk -->
    <style name="Theme.SignagePlayer.Fullscreen" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#8083FF</item>
        <item name="colorPrimaryDark">#0B0E14</item>
        <item name="colorAccent">#4CD7F6</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColor">#E1E2EB</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Settings UI style -->
    <style name="SettingsEditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#4CD7F6</item>
        <item name="hintTextColor">#C7C4D7</item>
    </style>

</resources>
