<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0E14" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Accent bar left -->
    <item android:width="6dp" android:gravity="start">
        <shape android:shape="rectangle">
            <solid android:color="#4CD7F6" />
        </shape>
    </item>
</layer-list>
