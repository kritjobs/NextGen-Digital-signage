# ============================================================
# NextGen Digital Signage Platform — Environment Variables
# ============================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ไขค่าให้ถูกต้อง
# cp .env.example .env.local
#
# ⚠️ ห้าม commit .env.local หรือไฟล์ที่มีค่าจริง
# ============================================================

# ─── App ─────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3100
APP_URL=http://localhost:3100
WS_PATH=/ws

# ─── PostgreSQL ──────────────────────────────────────────
# Container แยก ISOLATED: signage-postgres | Host port: 5433
# ⚠️ ใช้ localhost:5433 เมื่อรันบน host / ใช้ signage-postgres:5432 ใน Docker
DATABASE_URL=postgresql://signage_admin:SignageSecure2026!@signage-postgres:5432/signage_db
POSTGRES_HOST=signage-postgres
POSTGRES_PORT=5432
POSTGRES_DB=signage_db
POSTGRES_USER=signage_admin
POSTGRES_PASSWORD=SignageSecure2026!

# สำหรับรันบน host โดยตรง (ไม่ผ่าน Docker network):
# DATABASE_URL=postgresql://signage_admin:SignageSecure2026!@localhost:5433/signage_db

# ─── Redis ───────────────────────────────────────────────
# Container แยก ISOLATED: signage-redis | Host port: 6380
REDIS_URL=redis://signage-redis:6379
# สำหรับรันบน host: REDIS_URL=redis://localhost:6380

# ─── Security ────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_64_char_secret_in_production
CORS_ORIGIN=http://localhost:3100,http://localhost:5173

# ─── AI (optional) ───────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here

# ─── Development only ────────────────────────────────────
# ตั้งเป็น true เพื่อปิด HMR เมื่อรันใน AI agent mode
DISABLE_HMR=false

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=info
